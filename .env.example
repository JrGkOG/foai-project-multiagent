# Copy this to .env and fill in your key (loaded automatically on startup)
# cp .env.example .env

# ── LLM Configuration ─────────────────────────────
# Optional: without a key the agents run in rule-based mode.
GEMINI_API_KEY=your_gemini_api_key_here
# Leave blank to use the default (gemini-3.8-flash)
LLM_MODEL=
